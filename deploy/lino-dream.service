[Unit]
Description=Lino Dream Cycle — daily maintenance pipeline
Documentation=https://github.com/anomalyco/neural-memory
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/Beelzebub/Documents/neural-memory.bak/scripts/dream_cycle.py
User=Beelzebub
Group=Beelzebub
WorkingDirectory=/home/Beelzebub/Documents/neural-memory.bak
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
