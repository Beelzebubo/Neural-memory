[Unit]
Description=Lino Job Queue Worker — processes queued jobs
Documentation=https://github.com/anomalyco/neural-memory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/Beelzebub/Documents/neural-memory.bak/scripts/job_queue.py worker
User=Beelzebub
Group=Beelzebub
WorkingDirectory=/home/Beelzebub/Documents/neural-memory.bak
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
Nice=10

[Install]
WantedBy=multi-user.target
