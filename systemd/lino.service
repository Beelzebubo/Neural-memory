[Unit]
Description=Lino — Neural Memory Server
After=network.target

[Service]
Type=simple
User=Beelzebub
Group=Beelzebub
WorkingDirectory=/home/Beelzebub/Documents/Lino
EnvironmentFile=/home/Beelzebub/Documents/Lino/.env
ExecStart=/home/Beelzebub/Documents/Lino/.venv/bin/python -m uvicorn ui.app:app --host ${LINO_HOST:-127.0.0.1} --port ${LINO_PORT:-8210} --workers ${LINO_WORKERS:-2}
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=tmpfs
PrivateTmp=true
ReadWritePaths=/home/Beelzebub/Documents/Lino/data /home/Beelzebub/Documents/Lino/logs

[Install]
WantedBy=multi-user.target
